generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }

enum UserRole { CLIENT PARTNER COMPANY_ADMIN COMPANY_STAFF }
enum PartnerStatus { PENDING APPROVED REJECTED SUSPENDED }
enum ServiceCategory { SOFTWARE INFRASTRUCTURE TECHNICAL PROFESSIONAL }
enum ServiceStatus { REQUESTED ACTIVE PAUSED COMPLETED CANCELLED }
enum BillingCycle { ONE_TIME MONTHLY YEARLY USAGE }
enum ApplicationStatus { REQUESTED BUILDING ACTIVE DEGRADED DOWN SUSPENDED COMPLETED }
enum TicketStatus { OPEN IN_PROGRESS RESOLVED CLOSED }

model User {
 id String @id @default(cuid())
 name String
 email String @unique
 passwordHash String
 role UserRole @default(CLIENT)
 organizations OrganizationMember[]
 partner PartnerProfile?
 partnerApplication PartnerApplication?
 supportTickets SupportTicket[]
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
}
model Organization {
 id String @id @default(cuid())
 name String
 ownerId String
 members OrganizationMember[]
 services ClientService[]
 applications Application[]
 tickets SupportTicket[]
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
}
model OrganizationMember {
 id String @id @default(cuid())
 userId String
 organizationId String
 role String @default("OWNER")
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
 createdAt DateTime @default(now())
 @@unique([userId,organizationId])
}
model Service {
 id String @id @default(cuid())
 name String
 slug String @unique
 description String
 category ServiceCategory
 active Boolean @default(true)
 oneTimePriceKobo Int @default(0)
 monthlyPriceKobo Int @default(0)
 yearlyPriceKobo Int @default(0)
 clientServices ClientService[]
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
}
model ClientService {
 id String @id @default(cuid())
 organizationId String
 serviceId String
 status ServiceStatus @default(REQUESTED)
 billingCycle BillingCycle @default(MONTHLY)
 priceKobo Int @default(0)
 startDate DateTime?
 nextBillingDate DateTime?
 organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
 service Service @relation(fields:[serviceId],references:[id],onDelete:Restrict)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@unique([organizationId,serviceId])
}
model Application {
 id String @id @default(cuid())
 organizationId String
 name String
 productName String
 status ApplicationStatus @default(REQUESTED)
 url String?
 organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
}
model PartnerProfile {
 id String @id @default(cuid())
 userId String @unique
 status PartnerStatus @default(PENDING)
 bio String?
 capabilities PartnerCapability[]
 clients PartnerClient[]
 work PartnerWork[]
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
}
model PartnerCapability { id String @id @default(cuid()); partnerId String; name String; partner PartnerProfile @relation(fields:[partnerId],references:[id],onDelete:Cascade); @@unique([partnerId,name]) }
model PartnerApplication { id String @id @default(cuid()); userId String @unique; capabilities String; message String?; status PartnerStatus @default(PENDING); user User @relation(fields:[userId],references:[id],onDelete:Cascade); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model PartnerClient { id String @id @default(cuid()); partnerId String; organizationId String; partner PartnerProfile @relation(fields:[partnerId],references:[id],onDelete:Cascade); createdAt DateTime @default(now()); @@unique([partnerId,organizationId]) }
model PartnerWork { id String @id @default(cuid()); partnerId String; title String; description String?; status String @default("ASSIGNED"); partner PartnerProfile @relation(fields:[partnerId],references:[id],onDelete:Cascade); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model SupportTicket { id String @id @default(cuid()); userId String; organizationId String?; subject String; message String; status TicketStatus @default(OPEN); user User @relation(fields:[userId],references:[id],onDelete:Cascade); organization Organization? @relation(fields:[organizationId],references:[id],onDelete:SetNull); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model AuditLog { id String @id @default(cuid()); actorId String?; action String; entity String; entityId String?; metadata Json?; createdAt DateTime @default(now()) }
