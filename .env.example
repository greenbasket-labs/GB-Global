# PostgreSQL connection used by Prisma
DATABASE_URL="postgresql://postgres:password@localhost:5432/gb_global"

# Long random secret used to sign the Green Basket session cookie
SESSION_SECRET="replace-with-a-long-random-secret"

# Used only by: npm run admin:create
ADMIN_EMAIL="admin@example.com"
ADMIN_NAME="Green Basket Admin"
ADMIN_PASSWORD="replace-with-a-strong-password-at-least-12-characters"
