# PostgreSQL connection used by Prisma
DATABASE_URL="postgresql://postgres:password@localhost:5432/gb_global"

# Long random secret used to sign the Green Basket session cookie
SESSION_SECRET="replace-with-a-long-random-secret"

# Base64-encoded 32-byte key used to encrypt and hash platform CAC identity data
CAC_IDENTITY_KEY="replace-with-a-base64-encoded-32-byte-key"

# Used only by: npm run admin:create
ADMIN_EMAIL="admin@example.com"
ADMIN_NAME="Green Basket Admin"
ADMIN_PASSWORD="replace-with-a-strong-password-at-least-12-characters"

# Transactional email used for client verification OTPs
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM="Green Basket <verify@your-verified-domain.com>"

# Public URL of the dedicated School Management System demo environment
NEXT_PUBLIC_SCHOOL_DEMO_URL="https://school-demo.example.com"
